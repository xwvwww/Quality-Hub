POSTGRES_DB=quality_hub
NODE_ENV=development
POSTGRES_USER=quality_hub
POSTGRES_PASSWORD=local-only-change-me
DATABASE_URL=postgresql://quality_hub:quality_hub_dev@localhost:5432/quality_hub?schema=public
REDIS_URL=redis://localhost:6379
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local-only-change-me-too
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false # local development only; production must be true
SWAGGER_ENABLED=true # local development only; production must be false
ALLOW_DEMO_SEED=false
FRONTEND_URL=http://localhost:3000
# Set to the exact number of trusted reverse proxies in production; keep 0 locally.
TRUST_PROXY_HOPS=0
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Set an explicit comma-separated HTTPS host allowlist before using repository checkouts.
QUALITY_HUB_ALLOWED_REPOSITORY_HOSTS=
